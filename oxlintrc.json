{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript"],
  "env": {
    "browser": true,
    "es2022": true
  },
  "categories": {
    "correctness": "warn",
    "perf": "warn",
    "suspicious": "warn"
  },
  "ignorePatterns": ["dist", "node_modules"]
}
